<?xml version="1.0" encoding="utf-8"?>
<!--
    Sauvegarde automatique Android (versions <= 11) : TOUT est exclu. Les données des enfants
    (base Room, photos, préférences) ne quittent jamais le téléphone. android:allowBackup="false"
    est de toute façon positionné dans le manifeste ; ces règles sont une seconde barrière.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
