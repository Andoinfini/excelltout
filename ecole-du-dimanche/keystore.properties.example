# Modèle de configuration de signature pour la version release.
# 1. Copier ce fichier en « keystore.properties » (déjà ignoré par Git).
# 2. Remplacer les valeurs ci-dessous par celles de VOTRE clé de signature.
# Ne jamais versionner la clé (.jks) ni ses mots de passe.
storeFile=/chemin/absolu/vers/ma-cle.jks
storePassword=MOT_DE_PASSE_DU_KEYSTORE
keyAlias=ALIAS_DE_LA_CLE
keyPassword=MOT_DE_PASSE_DE_LA_CLE
